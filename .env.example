# ==============================================================================
# Enterprise CRM Template - Environment Configuration
# ==============================================================================

# Database Persistence Mode
# Set to 'true' to use the local reactive mock engine with browser localStorage sync.
# Set to 'false' when connecting to live Supabase PostgreSQL.
VITE_USE_MOCK=true

# Supabase Credentials (Required only when VITE_USE_MOCK=false)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Client Profile & Brand Identifier
VITE_CLIENT_ID=client-master-template
VITE_APP_TITLE="Enterprise CRM"
